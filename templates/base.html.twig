<!DOCTYPE html >
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Upload your heavy files with Bigupload">
        <meta name="keywords" content="Upload files, heavy files, files transfer, Bigupload">
        <meta name="author" content="Rapkalin">
        <title>{% block title %}Bigupload{% endblock %}</title>
        <link rel="icon" href="{{ asset("styles/images/favicon.svg") }}" sizes="any" type="image/svg+xml" >
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset("styles/app.css") }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app', {'nonce': csp_nonce('script')}) }}
            {% endblock %}
        {% endblock %}
    </head>
    {# Turbo Drive disabled: the page scripts (upload.js, plupload) expect full page loads #}
    <body data-turbo="false">
        {% block body %}{% endblock %}
        <footer id="app-footer">Bigupload v{{ app_version }}</footer>
    </body>
</html>
