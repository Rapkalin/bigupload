{% extends 'base.html.twig' %}

{% block title %}Send large files up to {{ constant(upload_config ~ 'MAX_FILE_SIZE_GB') }} GB{% endblock %}

{% block meta %}
    <link rel="canonical" href="{{ url('home.index') }}">
    <meta property="og:url" content="{{ url('home.index') }}">
{% endblock %}

{% block javascripts %}
    <script defer src="{{ asset('library/plupload/plupload.full.min.js') }}"></script>
    <script defer src="{{ asset('scripts/upload.js') }}"></script>
{% endblock %}

{% block body %}
    <main class="container ctn-row">
        {% include 'blocks/left-side.html.twig' %}
        {% include 'components/card.html.twig' with {'template': 'upload'} %}
    </main>
{% endblock %}
