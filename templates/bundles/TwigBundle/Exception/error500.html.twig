{% extends 'base.html.twig' %}

{% block title %}Error{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block body %}
    <main class="container container-error">
        <div class="message-error">
            <h1 class="title-error">Error</h1>
            <p class="text-error">
                Something went wrong on our side.<br>
                Please try again in a few minutes.
            </p>
            {% include 'components/buttons/link-button.html.twig' with {
                'id': 'error-404-btn',
                'color': 'blue',
                'text': 'Upload a new file',
                'href': path('home.index')
            } %}
        </div>
    </main>
{% endblock %}