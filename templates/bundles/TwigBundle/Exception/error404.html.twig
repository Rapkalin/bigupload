{% extends 'base.html.twig' %}

{% block title %}File not found{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block body %}
    <main class="container container-error">
        <div class="message-error">
            {% include 'components/icon.html.twig' with {'name': 'circle-chevron-down'} %}
            <h1 class="title-error">File not found</h1>
            <p class="text-error">{{ exception.message |nl2br }}</p>
            {% include 'components/buttons/link-button.html.twig' with {
                'id': 'error-404-btn',
                'color': 'blue',
                'text': 'Upload a new file',
                'href': path('home.index')
            } %}
        </div>
    </main>
{% endblock %}